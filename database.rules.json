{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        "events": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$eventId": {
            ".validate": "newData.hasChild('ts') && newData.child('ts').isNumber()"
          }
        }
      }
    }
  }
}
